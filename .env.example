# Required — the app will not start without these.
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net
DB_NAME=solix
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Recommended — comma-separated list of origins allowed to call the API.
# Defaults to "*" (any origin) if unset.
CORS_ORIGINS=https://akshatsingh-solix.github.io

# Optional — the AI concierge (chat.py). Leave unset to have it degrade to
# a clean 503; every other feature works without it. Set OPENAI_API_KEY
# directly in your hosting provider's environment settings (e.g. Render's
# dashboard), never commit it to a file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Free alternative: an OpenRouter key (https://openrouter.ai/keys). When set it
# is used instead of OPENAI_API_KEY, trying CHAT_MODELS in order (defaults to
# free models; free usage is capped at 50 requests/day, 1,000/day once $10 of
# credits has been bought).
OPENROUTER_API_KEY=
CHAT_MODELS=google/gemma-4-31b-it:free,thinkingmachines/inkling-small:free,nvidia/nemotron-3.5-lightning:free,openrouter/free

# Optional — Admin > SEO (seo.py). Every source is optional; without one the
# dashboard shows labelled sample data. The AI answer check uses
# OPENROUTER_API_KEY above (OPENROUTER_MODELS picks its models).
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free
SEMRUSH_API_KEY=
# Hot-topic radar: NewsMCP story clusters (free key at platform.newsmcp.com;
# keyless calls are blocked from cloud servers) and Parallel deep dives
# (parallel.ai, $5 free credits a month).
NEWSMCP_API_KEY=
PARALLEL_API_KEY=

# Optional — Emergent-platform email delivery. Leave unset outside
# Emergent; lead email alerts (emailer.py) degrade gracefully without it.
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Solix Technologies
EMAIL_REPLY_TO=
SALES_ALERT_EMAIL=

# Email delivery (lead alerts, event confirmations, gated asset emails).
# The first configured transport is used:
#   1. SMTP - any provider (Microsoft 365, Google Workspace, Amazon SES, SendGrid, Mailgun...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SSL=true for port 465
#   2. Resend - https://resend.com (API key + a verified sender domain)
RESEND_API_KEY=
#   3. EMERGENT_EMAIL_KEY above (links only, no attachments)
# Sender address for SMTP and Resend, e.g. marketing@solix.com
EMAIL_FROM=

# Public addresses used in emails: download links point at this API, and
# "read the full article" links at the website. Both must be https://.
PUBLIC_API_URL=https://solix-backend-mf5w.onrender.com
SITE_URL=https://akshatsingh-solix.github.io/Website

# --- Radar + EchoLocate (all optional) ----------------------------------------
# Real outbound email leaves only when this is 1. Until then sends through SMTP or
# Instantly are held (not sent, not counted); dry-run sequences still simulate.
OUTBOUND_LIVE_SENDING=
# AI providers allowed to see prospect personal data (Radar deep dives, openers, reply
# classification). Default openai; free tiers have no DPA. "none" keeps those on rules.
LLM_PII_PROVIDERS=openai
# Crustdata job index for the Radar (paid credits; capped per run in Admin > Radar).
CRUSTDATA_API_KEY=
# Instantly: email sending through your existing campaigns, and the webhook that
# reports replies, bounces and meetings back. Connect from Admin > Outbound.
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=
# Live account research for the Radar. Firecrawl (firecrawl.dev, 1,000 free credits a month) searches the web and
# reads leadership pages; PARALLEL_API_KEY above is the backup when Firecrawl isn't set or fails.
FIRECRAWL_API_KEY=
# Hunter (hunter.io, 25 free searches a month): work emails, titles and the email pattern for an account's domain.
HUNTER_API_KEY=
# The API pings its own PUBLIC_API_URL every 10 minutes so Render's free tier never sleeps; 0 turns it off.
KEEP_AWAKE=1
# The Radar's daily run (collect, score, research, digest) starts inside the API at this UTC time; "off" turns it off.
RADAR_DAILY_UTC=05:00
# Self-hosted Reacher (free, MIT) to verify mailboxes, e.g. http://reacher:8080
REACHER_URL=
REACHER_TOKEN=
# Digiprise one-way sync (URL can also be set in Admin > Outbound > Health).
DIGIPRISE_URL=
DIGIPRISE_TOKEN=
# Slack incoming webhooks (or set them in the admin).
SLACK_WEBHOOK_REPLIES=
SLACK_WEBHOOK_PIPELINE=
SLACK_WEBHOOK_CONFLICTS=
SLACK_WEBHOOK_WATCHDOG=
# Lets an external scheduler call POST /api/ops/tick when the API sleeps.
OPS_TOKEN=
# Signs unsubscribe links (defaults to JWT_SECRET).
UNSUBSCRIBE_SECRET=
