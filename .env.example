# Required — the app will not start without these.
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net
DB_NAME=solix
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Recommended — comma-separated list of origins allowed to call the API.
# Defaults to "*" (any origin) if unset.
CORS_ORIGINS=https://akshatsingh-solix.github.io

# Optional — Emergent-platform integrations. Leave unset outside Emergent;
# the AI concierge (chat.py) and lead email alerts (emailer.py) both
# degrade gracefully without them, everything else works normally.
EMERGENT_LLM_KEY=
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Solix Technologies
EMAIL_REPLY_TO=
SALES_ALERT_EMAIL=
